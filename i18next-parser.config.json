{
  "contextSeparator": "_",
  "createOldCatalogs": true,
  "defaultNamespace": "translation",
  "defaultValue": "",
  "indentation": 2,
  "keepRemoved": false,
  "keySeparator": false,
  "lexers": {
    "htm": ["HTMLLexer"],
    "html": ["HTMLLexer"],
    "js": ["JavascriptLexer"],
    "ts": ["JavascriptLexer"],
    "jsx": ["JsxLexer"],
    "tsx": ["JsxLexer"],
    "default": ["JavascriptLexer"]
  },
  "lineEnding": "auto",
  "locales": ["en", "ru", "es"],
  "namespaceSeparator": false,
  "output": "src/features/localization/locales/$LOCALE/$NAMESPACE.json",
  "pluralSeparator": "_",
  "input": ["src/**/*.ts*"],
  "sort": true,
  "skipDefaultValues": false,
  "useKeysAsDefaultValue": true,
  "verbose": true,
  "failOnWarnings": false,
  "failOnUpdate": false,
  "customValueTemplate": null,
  "resetDefaultValueLocale": null,
  "i18nextOptions": null,
  "yamlOptions": null
}
